# ===== Engenheiro de Campo IA — backend local =====
# Copie para backend/.env (o start-backend.bat faz isso automaticamente).

# Segurança do login (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXP_HOURS=168

# Banco SQLite (padrão: backend/data/app.db)
# SQLITE_PATH=data/app.db

# Cria obra e usuários de demonstração no primeiro start (senha abaixo)
SEED_DEMO=true
DEMO_PASSWORD=demo123

# Origens liberadas no CORS (* = qualquer uma; em produção liste as URLs)
CORS_ORIGINS=*

# ---- IA (opcional — as duas primeiras são GRATUITAS) ----
# Groq: chat do copiloto (assistente especializado) + voz (Whisper large-v3) no chat e no RDO
#   Crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Gemini Flash: identificação de PATOLOGIAS por foto (com caixas para o futuro detector YOLO)
#   Crie a chave em https://aistudio.google.com/apikey  (plano grátis: o Google pode usar os dados enviados)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Detector YOLO local (deixe vazio até treinar — ver backend/yolo_treinar.py)
YOLO_MODEL_PATH=

# Claude (pago, opcional): alternativa para chat e para as demais análises de foto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI Whisper (pago, opcional): alternativa ao Groq na transcrição
OPENAI_API_KEY=

# ---- WhatsApp Cloud API (opcional) ----
# Sem estes dados o app gera um link wa.me para envio manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=
WHATSAPP_API_VERSION=v21.0

# ---- E-mail (confirmação, esqueci a senha, aviso de acesso) ----
# Endereço usado nos links dos e-mails. Vazio = automático (usa o endereço que o app
# usou para falar com o backend; no celular é o IP do PC). Só preencha se o backend
# estiver publicado num endereço fixo (ex.: https://api.suaobra.com.br)
PUBLIC_BASE_URL=
# Confere no DNS se o domínio do e-mail existe, na hora do cadastro
CHECK_EMAIL_DOMAIN=true
# Sem SMTP_HOST os e-mails só aparecem no terminal do backend (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
