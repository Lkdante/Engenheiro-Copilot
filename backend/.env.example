# ===== Engenheiro de Campo IA — backend local =====
# Copie para backend/.env (o start-backend.bat faz isso automaticamente).

# Segurança do login (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXP_HOURS=168

# Banco SQLite (padrão: backend/data/app.db)
# SQLITE_PATH=data/app.db

# Cria obra e usuários de demonstração no primeiro start (senha abaixo)
SEED_DEMO=true
DEMO_PASSWORD=demo123

# Origens liberadas no CORS (* = qualquer uma; em produção liste as URLs)
CORS_ORIGINS=*

# ---- IA (opcional) ----
# Chatbot, análise de fotos/inspeções e checklists personalizados (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Transcrição de áudio do RDO por voz (Whisper)
OPENAI_API_KEY=

# ---- WhatsApp Cloud API (opcional) ----
# Sem estes dados o app gera um link wa.me para envio manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=
WHATSAPP_API_VERSION=v21.0

# ---- E-mail (confirmação, esqueci a senha, aviso de acesso) ----
# Endereço usado nos links dos e-mails. Vazio = automático (usa o endereço que o app
# usou para falar com o backend; no celular é o IP do PC). Só preencha se o backend
# estiver publicado num endereço fixo (ex.: https://api.suaobra.com.br)
PUBLIC_BASE_URL=
# Confere no DNS se o domínio do e-mail existe, na hora do cadastro
CHECK_EMAIL_DOMAIN=true
# Sem SMTP_HOST os e-mails só aparecem no terminal do backend (modo dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
