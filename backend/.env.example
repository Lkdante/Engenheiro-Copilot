# ===== Engenheiro de Campo IA — backend local =====
# Copie para backend/.env (o start-backend.bat faz isso automaticamente).

# Segurança do login (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
JWT_EXP_HOURS=168

# Banco SQLite (padrão: backend/data/app.db)
# SQLITE_PATH=data/app.db

# Cria obra e usuários de demonstração no primeiro start (senha abaixo)
SEED_DEMO=true
DEMO_PASSWORD=demo123

# Origens liberadas no CORS (* = qualquer uma; em produção liste as URLs)
CORS_ORIGINS=*

# ---- IA (opcional) ----
# Chatbot, análise de fotos/inspeções e checklists personalizados (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Transcrição de áudio do RDO por voz (Whisper)
OPENAI_API_KEY=

# ---- WhatsApp Cloud API (opcional) ----
# Sem estes dados o app gera um link wa.me para envio manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=
WHATSAPP_API_VERSION=v21.0
