{
  "expo": {
    "name": "Engenheiro de Campo IA",
    "slug": "engenheiro-copilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "engenheirocopilot",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Fotografar canteiro de obras e inspeções",
        "NSMicrophoneUsageDescription": "Gravar áudio para RDO por voz",
        "NSPhotoLibraryUsageDescription": "Anexar fotos do canteiro"
      },
      "bundleIdentifier": "com.engenheirocopilot.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.engenheirocopilot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Gravar áudio para RDO por voz",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fotografar canteiro de obras e inspeções",
          "microphonePermission": "Gravar áudio para RDO por voz"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Anexar fotos do canteiro",
          "cameraPermission": "Fotografar canteiro de obras e inspeções"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
